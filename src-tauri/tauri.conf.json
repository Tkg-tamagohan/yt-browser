{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yt-browser",
  "version": "0.5.0",
  "identifier": "io.github.tkg-tamagohan.yt-browser",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "yt-browser",
        "width": 1024,
        "height": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://i.ytimg.com https://*.ggpht.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["yt-browser"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyRUM4Nzc3RkEzOUY5QTEKUldTaCtUbjZkNGZzZ3RiaUdHaU84OUFWL2NWKzBGWS9jczZxb01YSzh2Rnhpd29oTCtJWktoUlEK",
      "endpoints": [
        "https://github.com/Tkg-tamagohan/yt-browser/releases/latest/download/latest.json"
      ]
    }
  }
}